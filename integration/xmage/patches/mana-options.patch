+    // MageZero patch: with many mana abilities that cost mana (Kinnan with filter rocks)
+    // the options grew without bound and one getManaAvailable call took minutes, ignoring
+    // interrupts. Options are an affordability estimate, so keep the largest ones.
+    private static final int MAX_OPTIONS = 64;
+    private static final int MAX_SIMULATED_REPEATS = 4;
+
+    private void limitOptions() {
+        if (this.size() <= MAX_OPTIONS) {
+            return;
+        }
+        removeFullyIncludedVariations();
+        if (this.size() > MAX_OPTIONS) {
+            List<Mana> kept = new ArrayList<>(this);
+            kept.sort(Comparator.comparingInt((Mana mana) -> mana.count()).reversed());
+            this.clear();
+            this.addAll(kept.subList(0, MAX_OPTIONS));
+        }
+    }
